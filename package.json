{
  "name": "downeastcyclists",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh && node scripts/prepare-effect-tsgo.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "format": "oxfmt",
    "resend:setup-organizer-template": "./scripts/setup-resend-organizer-template.sh",
    "resend:setup-renewal-template": "./scripts/setup-resend-renewal-template.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "tsc": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
    "tsgo": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrations:check": "sh scripts/check-drizzle-migrations.sh",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "types:contentful": "export $(cat .env.local | awk '!/^\\s*#/' | awk '!/^\\s*$/'); cf-content-types-generator --spaceId $CONTENTFUL_SPACE_ID --token $CONTENTFUL_MANAGEMENT_TOKEN -o src/contentful/types -X && prettier --write src/contentful/types"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.2.2",
    "@contentful/rich-text-types": "^17.2.7",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@fontsource/poppins": "5.2.5",
    "@google-cloud/firestore": "^8.7.0",
    "@hcaptcha/react-hcaptcha": "^1.12.0",
    "@hookform/resolvers": "^5.0.1",
    "@mui/icons-material": "6.5.0",
    "@mui/material": "6.5.0",
    "@mui/material-nextjs": "6.5.0",
    "@neondatabase/serverless": "^1.0.2",
    "@netlify/neon": "^0.1.2",
    "@tanstack/pacer": "^0.17.3",
    "@tanstack/react-pacer": "^0.19.3",
    "@tanstack/react-query": "5.66.11",
    "clsx": "2.1.1",
    "contentful": "^11.12.7",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "html-to-image": "^1.11.13",
    "next": "15.5.21",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.2",
    "react-is": "^19.2.7",
    "react-markdown": "^10.0.0",
    "react-typed": "^2.0.12",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.0",
    "sharp": "^0.35.3",
    "stripe": "^20.1.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.19.0",
    "@netlify/plugin-nextjs": "^5.15.11",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.0.1",
    "cf-content-types-generator": "2.15.5",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "netlify-cli": "^22.2.1",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3",
    "tsx": "^4.21.0",
    "typescript": "5.8.2",
    "vitest": "^4.0.17",
    "vitest-mock-extended": "^3.1.0"
  },
  "packageManager": "pnpm@11.5.0"
}
